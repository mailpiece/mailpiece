<%= render "shared/status_filter", status: status, links: [
      [ nil, t("posts_state_all"), posts_path, Current.account.posts.count ],
      [ :draft, t("posts_state_draft"), posts_draft_path, Current.account.posts.drafts.unscheduled.count ],
      [ :scheduled, t("posts_state_scheduled"), posts_scheduled_path, Current.account.posts.scheduled.count ],
      [ :published, t("posts_state_published"), posts_published_path, Current.account.posts.published.on_the_web.count ],
      [ :sent, t("posts_state_sent"), posts_sent_path, Current.account.posts.sent.count ]
    ] %>
