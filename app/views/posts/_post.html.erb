<%= tag.li id: dom_id(post),
      class: "row",
      style: "view-transition-name: #{dom_id post}",
      tabindex: -1,
      data: { quick_find_target: "item", navigable_list_target: "item" } do %>
  <%= link_to edit_post_path(post), class: "display-contents" do %>
    <span class="row__body">
      <span class="row__title"><%= post_title(post) %></span>
      <span class="row__meta"><%= post_meta(post) %></span>
    </span>
    <span class="row__end row__end--stacked">
      <%= local_datetime_tag post_status_time(post), style: :timeordate %>
      <%= status_tag post.state %>
    </span>
  <% end %>
<% end %>
