<%= t("mailers_reply_from", address: @reply.from_address, subject: @reply.subject) %>

<%= @reply.text %>
<% if @reply.attachments_count > 0 %>

<%= t("mailers_reply_attachments_not_forwarded", count: @reply.attachments_count) %>
<% end %>

<%= subscriber_url(@reply.subscriber, script_name: @account.slug) %>

<%= t("mailers_reply_turn_off_text", url: notifications_settings_url(script_name: @account.slug)) %>
