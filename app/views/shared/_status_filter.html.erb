<%# The states as { status => title }, the list's default first; the button reads the chosen one's title, or the prompt on the default. %>
<% default = statuses.keys.first %>

<%= form_with url: url, method: :get, class: "display-contents", data: { controller: "form", turbo_frame: frame, turbo_action: "advance" } do %>
  <%= tag.div class: class_names("quick-filter", "quick-filter--with-default": status == default),
        data: {
          controller: "dialog combobox",
          action: "keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside",
          combobox_default_value_value: default,
          combobox_default_label_value: local_assigns[:prompt],
          combobox_with_default_class: "quick-filter--with-default" } do %>
    <button type="button" class="btn input input--select flex-inline txt-x-small" data-action="click->dialog#toggle:stop">
      <span class="overflow-ellipsis" data-combobox-target="label"><%= (local_assigns[:prompt] if status == default) || statuses[status] %></span>
    </button>

    <template data-combobox-target="hiddenFieldTemplate">
      <%= hidden_field_tag :status, nil %>
    </template>

    <%= filter_dialog t("filter_status_label") do %>
      <%= filter_title t("filter_status_label") %>

      <ul class="popup__list" role="listbox">
        <% statuses.each do |value, title| %>
          <%= tag.li class: "popup__item", data: {
                navigable_list_target: "item", combobox_target: "item", combobox_value: value, combobox_label: title },
                role: "checkbox", aria: { checked: status == value } do %>
            <button type="button" class="btn popup__btn" data-action="dialog#close combobox#change form#submit">
              <span class="overflow-ellipsis flex-item-grow"><%= title %></span>
              <%= icon_tag "check", class: "checked flex-item-justify-end" %>
            </button>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>
