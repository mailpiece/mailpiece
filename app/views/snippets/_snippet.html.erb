<%= tag.li id: dom_id(snippet),
      class: "row",
      style: "view-transition-name: #{dom_id snippet}",
      tabindex: -1,
      data: { quick_find_target: "item", navigable_list_target: "item" } do %>
  <%= link_to edit_snippet_path(snippet), class: "display-contents" do %>
    <span class="row__body">
      <span class="row__title"><%= snippet.name %></span>
    </span>
    <span class="row__end">
      <%= local_datetime_tag snippet.updated_at, style: :timeordate %>
    </span>
  <% end %>
<% end %>
