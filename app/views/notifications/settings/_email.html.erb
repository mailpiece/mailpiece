<section class="settings__section">
  <%= form_with model: settings, url: notifications_settings_path, method: :patch, data: { controller: "form" } do |form| %>
    <ul class="flex flex-column align-start gap-half margin-none unpad">
      <li class="list-style-none margin-none">
        <label class="flex align-center gap cursor-pointer">
          <span class="switch flex-item-no-shrink">
            <%= form.check_box :new_subscriber_notifications, class: "switch__input", data: { action: "change->form#submit" } %>
            <span class="switch__btn round"></span>
          </span>
          <span class="min-width"><%= t("users_notification_settings_new_subscriber") %></span>
        </label>
      </li>
      <li class="list-style-none margin-none">
        <label class="flex align-center gap cursor-pointer">
          <span class="switch flex-item-no-shrink">
            <%= form.check_box :reply_forwarding, class: "switch__input", data: { action: "change->form#submit" } %>
            <span class="switch__btn round"></span>
          </span>
          <span class="min-width"><%= t("users_notification_settings_reply_forwarding") %></span>
        </label>
      </li>
    </ul>
  <% end %>
</section>
