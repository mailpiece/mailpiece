<div class="page flex flex-column gap">
  <%= render layout: "shared/filter", locals: { what: t("subscribers_filter_what"), search: search_path,
        quick_filters: render("subscribers/status_filter", status: status) } do %>
    <% if page.used? %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <ul class="rows">
          <%= with_automatic_pagination :subscribers, page do %>
            <%= render partial: "subscribers/subscriber", collection: page.records %>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="blank-slate fit-content center"><%= subscribers_empty_message status %></div>
    <% end %>
  <% end %>
</div>
