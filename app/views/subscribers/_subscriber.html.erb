<li id="<%= dom_id subscriber %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= link_to subscriber_path(subscriber), class: "display-contents" do %>
    <%= avatar_tag nil, subscriber.email %>
    <span class="row__body">
      <span class="row__title"><%= subscriber.email %></span>
      <span class="row__meta"><%= subscriber_meta subscriber %></span>
    </span>
    <span class="row__end row__end--stacked">
      <%= local_datetime_tag subscriber_status_time(subscriber), style: :timeordate %>
      <%= row_status_tag subscriber.status %>
    </span>
  <% end %>
</li>
