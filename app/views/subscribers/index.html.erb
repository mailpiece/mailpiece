<% @page_title = t("subscribers") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= new_link_to t("subscribers_add_title"), new_subscribers_batch_path %>
  </div>
<% end %>

<% if Current.account.subscribers.exists? %>
  <%= render "subscribers/list", page: @page, status: @status %>
<% else %>
  <div class="page flex flex-column gap">
    <div class="blank-slate fit-content center"><%= t "subscribers_empty_html", link: link_to(t("subscribers_empty_link"), new_subscribers_batch_path) %></div>
  </div>
<% end %>
